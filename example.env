# TRT-Parts Backend — muhit o'zgaruvchilari
# Ishlatish: bu faylni nusxalab `.env` deb saqlang (`.env` gitga kirmaydi)
#   cp example.env .env   (Linux/Mac)
#   copy example.env .env (Windows)

########################
# Server
########################
NODE_ENV=development
PORT=7000
HOST=0.0.0.0

# Rasmlar va fayllar uchun tashqi URL (oxirida / bo'lmasin)
BASE_URL=http://localhost:7000

########################
# PostgreSQL
########################
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=trt_parts_db

# true — TypeORM jadvallarni avtomatik yangilaydi (productionda false tavsiya)
DB_SYNC=true

# Production DB SSL kerak bo'lsa: true
DB_SSL=false

########################
# Auth (JWT)
########################
JWT_SECRET=super-secret-jwt-key-change-me
JWT_EXPIRES_IN=1d

########################
# CORS
# Bir nechta origin: https://site.com,https://www.site.com
# Hammasiga ruxsat: *
########################
CORS_ORIGIN=*

########################
# Swagger (API hujjatlari)
########################
SWAGGER_ENABLE=true
SWAGGER_PATH=docs
SWAGGER_USER=admin
SWAGGER_PASS=change-me

########################
# Contact form — SMTP (email yuborish)
########################
SMTP_HOST=smtp.your-mail-host.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password

# Contact formadan kelgan xabarlar shu manzilga tushadi
CONTACT_EMAIL=contact@trt-parts.com

########################
# Google Analytics GA4 (ixtiyoriy)
########################
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_PROPERTY_ID=000000000
GA4_SERVICE_ACCOUNT_FILE=./ga4-service-account.json

# Yoki JSON ni to'g'ridan-to'g'ri string sifatida (fayl o'rniga):
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
